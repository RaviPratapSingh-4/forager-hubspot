FORAGER_API_KEY=
FORAGER_ACCOUNT_ID=2800
HUBSPOT_TOKEN=
# shared secret for webhooks and the /enrich, /find-contacts endpoints
WEBHOOK_SECRET=change-me-long-random
# optional: HubSpot app client secret (v3 signature verification)
HUBSPOT_CLIENT_SECRET=
# public https URL of the deployed service (needed for signature verification)
PUBLIC_BASE_URL=
CACHE_DIR=.cache
# title-filter defaults (comma separated)
DEFAULT_INCLUDE=
DEFAULT_EXCLUDE=intern,assistant,student,recruiter
DEFAULT_SENIORITY=c_level,vp,director,head
DEFAULT_LIMIT=5
MAX_CANDIDATES=15
PERSONAL_EMAIL_FALLBACK=false
# optional per-endpoint credit costs from your dashboard, e.g. {"organization_search":1,"phone_numbers":10}
FORAGER_COSTS={}
